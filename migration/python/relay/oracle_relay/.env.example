# Copy this file to ".env" on the Oracle VM and fill in your real values.
# NEVER commit the real ".env" file — it's already excluded via .gitignore
# in this folder.

BROKER_API_KEY=
BROKER_API_SECRET=

# A secret you make up yourself — any long random string. This is NOT your
# Flattrade password or API secret; it's a separate password just for SENTRY
# to talk to this relay, so nothing else can use it even if someone finds
# this server's address. Put the same value in SENTRY's own config
# (flattrade_relay_client.py) on your home PC.
RELAY_SHARED_SECRET=
